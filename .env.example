DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret"
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6"
NEXT_PUBLIC_APP_NAME="BaytiCare AI"

# Optional: S3-compatible file storage (Cloudflare R2, AWS S3, etc). If unset,
# uploads fall back to local disk, which does NOT persist on Vercel.
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_REGION="auto"
